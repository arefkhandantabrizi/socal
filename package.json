{
  "name": "socal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "watch:sass": "sass -w src/sass/main.scss src/styles/style.css ",
    "compile:sass": "sass src/sass/main.scss src/styles/style.comp.css",
    "prefix:css": "postcss --use autoprefixer -b 'last 10 versions' src/styles/style.comp.css -o src/styles/style.prefix.css",
    "compress:css": "sass --style=compressed src/styles/style.prefix.css src/styles/style.css ",
    "build:css": "npm-run-all compile:sass prefix:css compress:css"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "gsap": "^3.15.0",
    "next": "16.2.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-responsive": "^10.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.5.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.10",
    "postcss-cli": "^11.0.1",
    "sass": "^1.99.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
